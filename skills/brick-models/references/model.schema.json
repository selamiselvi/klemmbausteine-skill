{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brick Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "author",
    "license",
    "parts",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "part",
          "color",
          "x",
          "y",
          "z",
          "rotation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "part": {
            "enum": [
              "3001",
              "3002",
              "3003",
              "3004",
              "3005",
              "3010",
              "3020",
              "3021",
              "3022",
              "3023",
              "3024",
              "3795",
              "3034"
            ]
          },
          "color": {
            "enum": [
              "0",
              "1",
              "2",
              "4",
              "14",
              "15",
              "19",
              "71",
              "72",
              "272"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": -128,
            "maximum": 128
          },
          "y": {
            "type": "integer",
            "minimum": -128,
            "maximum": 128
          },
          "z": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          },
          "rotation": {
            "enum": [
              0,
              90
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "parts"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            }
          },
          "view": {
            "enum": [
              "front-right",
              "back-right",
              "back-left",
              "front-left"
            ]
          }
        }
      }
    }
  }
}
